Main-Class: com.liferay.project.templates.ProjectTemplates
Private-Package: \
	com.liferay.project.templates.*,\
	org.apache.maven.archetype.*,\
	org.codehaus.plexus.logging.console.*
-includeresource: \
	com.liferay.project.templates.*.jar,\
  	@jcommander-*.jar